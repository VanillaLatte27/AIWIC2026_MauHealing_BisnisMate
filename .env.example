# Application Server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
DEBUG=True

# Multimodal AI Provider (Google Gemini & Whisper)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here_without_quotes
WHISPER_LORA_ENDPOINT=http://localhost:9000/v1/audio/transcriptions

# Balinese Cultural Knowledge & RAG Vector Engine
CULTURAL_CALENDAR_REGION=BALI_CAKA_1948
VECTOR_DB_PATH=./data/caka_ontology_vector
EMBEDDING_MODEL=text-embedding-004

# SAK EMKM Accounting Rules Engine
ACCOUNTING_STANDARD=SAK_EMKM_IAI_2024
AUTO_BALANCING_STRICT_MODE=True
MAX_ALLOWED_VARIANCE_IDR=0

# Perbankan & KUR API Sandbox
KUR_SANDBOX_ENABLED=True
MANDIRI_KUR_API_KEY=sandbox_mandiri_mock_key
BRI_KUR_API_KEY=sandbox_bri_mock_key
BPD_BALI_KUR_API_KEY=sandbox_bpdbali_mock_key

# Security & Session
SESSION_SECRET=dev_insecure_secret_replace_in_production_jwt_key_here
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
